# ============================================
# Agentic DevOps Autopilot - Environment Config
# ============================================

# --------------------------------------------
# Database (Required)
# --------------------------------------------
# Use these values for local development with docker-compose.dev.yml
DATABASE_URL="postgresql://devops:devops123@localhost:5432/devops_autopilot?schema=public"

# For production, use your hosted PostgreSQL URL:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --------------------------------------------
# Redis (Required)
# --------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379

# --------------------------------------------
# Server (Required)
# --------------------------------------------
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# --------------------------------------------
# GitHub Integration (Optional)
# --------------------------------------------
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo, write:discussion
# Leave empty to test without GitHub integration
GITHUB_TOKEN=""
GITHUB_WEBHOOK_SECRET=""

# --------------------------------------------
# Railway Integration (Optional)
# --------------------------------------------
# Get your API token from: https://railway.app/account/tokens
# Leave empty to test without Railway integration
RAILWAY_API_TOKEN=""

# --------------------------------------------
# OpenAI Integration (Optional)
# --------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# Leave empty to test without AI analysis (incident data will still be collected)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4-turbo-preview"

# --------------------------------------------
# Notes:
# --------------------------------------------
# - The app works without API keys - you can explore with demo data
# - Run "make docker-dev" to start PostgreSQL and Redis locally
# - Run "make db-setup" to initialize database with demo data
# - See README.md for detailed setup instructions
